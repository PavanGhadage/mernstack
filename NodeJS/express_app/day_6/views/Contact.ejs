<html>
  <head>
    <title>Contact</title>
  </head>
  <body style="margin: 0; font-family: Arial; background: #222; color: white">
    <div style="background: #222; padding: 15px; text-align: center">
      <a href="/" style="color: white; margin: 15px; text-decoration: none"
        >Home</a
      >
      <a href="/About" style="color: white; margin: 15px; text-decoration: none"
        >About</a
      >
      <a href="/skill" style="color: white; margin: 15px; text-decoration: none"
        >Skills</a
      >
      <a
        href="/services"
        style="color: white; margin: 15px; text-decoration: none"
        >Services</a
      >
      <a
        href="/contact"
        style="color: white; margin: 15px; text-decoration: none"
        >Contact</a
      >
    </div>

    <section style="padding: 60px; text-align: center">
      <h1 style="font-size: 45px">Contact Me</h1>

      <form
        onsubmit="submitForm(event)"
        style="max-width: 500px; margin: auto; margin-top: 30px"
      >
        <input
          type="text"
          placeholder="Enter Your Name"
          required
          style="
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            border: none;
            border-radius: 5px;
          "
        />

        <input
          type="email"
          placeholder="Enter Your Email"
          required
          style="
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            border: none;
            border-radius: 5px;
          "
        />

        <textarea
          placeholder="Enter Message"
          required
          style="
            width: 100%;
            height: 120px;
            padding: 15px;
            border: none;
            border-radius: 5px;
          "
        ></textarea>

        <button
          type="submit"
          style="
            margin-top: 15px;
            padding: 12px 25px;
            border: none;
            background: #00bcd4;
            color: white;
            font-size: 18px;
            border-radius: 5px;
            cursor: pointer;
          "
        >
          Send Message
        </button>
      </form>
    </section>

    <script>
      function submitForm(event) {
        event.preventDefault();
        alert("Message Sent Successfully!");
      }
    </script>
  </body>
</html>
