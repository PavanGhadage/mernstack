<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course Details</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include("navbar.ejs") %>

<% if(mydata){ %>

<div class="details-container">

    <div class="details-card">

        <h1><%= mydata.name %></h1>

        <div class="detail-row">
            <span>Course ID</span>
            <span><%= mydata.id %></span>
        </div>

        <div class="detail-row">
            <span>Trainer</span>
            <span><%= mydata.trainer %></span>
        </div>

        <div class="detail-row">
            <span>Duration</span>
            <span><%= mydata.duration %></span>
        </div>

        <div class="detail-row">
            <span>Category</span>
            <span><%= mydata.category %></span>
        </div>

        <div class="detail-row">
            <span>Fees</span>
            <span>₹<%= mydata.fees %></span>
        </div>

        <div class="description">
            <h3>Description</h3>
            <p><%= mydata.description %></p>
        </div>

        <a href="/courses" class="btn">
            Back to Courses
        </a>

    </div>

</div>

<% } else { %>

<div class="error-container">

    <div class="error-card">

        <h1>❌ Invalid Course ID</h1>

        <p>
            The course you are looking for does not exist.
        </p>

        <a href="/courses" class="btn">
            Back to Courses
        </a>

    </div>

</div>

<% } %>

</body>
</html>